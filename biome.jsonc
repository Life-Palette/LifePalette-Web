{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "formatter": {
    "lineEnding": "auto"
  },
  "json": {
    "formatter": {
      "lineEnding": "auto"
    }
  },
  "files": {
    "includes": [
      "!!**/dist",
      "!!**/node_modules",
      "!!**/.git",
      "!!public",
      "!!**/*.svg",
      "!!src/routeTree.gen.ts",
      "!!src/components/ui",
      "!!components.json"
    ],
    "maxSize": 2097152
  }
}
